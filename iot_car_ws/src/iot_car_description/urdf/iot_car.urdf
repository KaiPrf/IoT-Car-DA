<?xml version="1.0"?>

<robot name="iot_car">

  <!-- ==================== CHASSIS ==================== -->

  <link name="base_link">

    <visual>
      <geometry>
        <box size="0.40 0.25 0.08"/>
      </geometry>

      <material name="chassis_color">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.40 0.25 0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.00574"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01387"
        iyz="0.0"
        izz="0.01854"/>
    </inertial>

  </link>


  <!-- ==================== FRONT LEFT WHEEL ==================== -->

  <link name="front_left_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>

      <material name="wheel_color">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.00007"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000125"
        iyz="0.0"
        izz="0.00007"/>
    </inertial>

  </link>

  <joint name="front_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.13 0.14 -0.04"/>
  </joint>


  <!-- ==================== FRONT RIGHT WHEEL ==================== -->

  <link name="front_right_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>

      <material name="wheel_color_right">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.00007"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000125"
        iyz="0.0"
        izz="0.00007"/>
    </inertial>

  </link>

  <joint name="front_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.13 -0.14 -0.04"/>
  </joint>


  <!-- ==================== REAR LEFT WHEEL ==================== -->

  <link name="rear_left_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>

      <material name="wheel_color_rear_left">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.00007"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000125"
        iyz="0.0"
        izz="0.00007"/>
    </inertial>

  </link>

  <joint name="rear_left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.13 0.14 -0.04"/>
  </joint>


  <!-- ==================== REAR RIGHT WHEEL ==================== -->

  <link name="rear_right_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>

      <material name="wheel_color_rear_right">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.00007"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000125"
        iyz="0.0"
        izz="0.00007"/>
    </inertial>

  </link>

  <joint name="rear_right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.13 -0.14 -0.04"/>
  </joint>

</robot>
