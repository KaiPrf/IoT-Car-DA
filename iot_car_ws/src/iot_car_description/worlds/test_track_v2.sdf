<?xml version="1.0"?>

<sdf version="1.9">
  <world name="iot_car_test_track">

    <!-- Gazebo-Systeme -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">

      <render_engine>ogre2</render_engine>

    </plugin>

    <!-- Grundeinstellungen -->
    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>


    <!-- Licht -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.4 0.3 -1</direction>
    </light>


    <!-- Boden -->
    <model name="ground">
      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <box>
              <size>14 10 0.10</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <box>
              <size>14 10 0.10</size>
            </box>
          </geometry>

          <material>
            <ambient>0.16 0.16 0.16 1</ambient>
            <diffuse>0.20 0.20 0.20 1</diffuse>
          </material>
        </visual>

      </link>

      <pose>0 0 -0.05 0 0 0</pose>
    </model>


    <!-- Äußere Streckenbegrenzung -->
    <model name="wall_top">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10.5 0.08 0.18</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>10.5 0.08 0.18</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>0 2.6 0.09 0 0 0</pose>
    </model>


    <model name="wall_bottom">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10.5 0.08 0.18</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>10.5 0.08 0.18</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>0 -2.6 0.09 0 0 0</pose>
    </model>


    <model name="wall_left">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 5.28 0.18</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 5.28 0.18</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>-5.25 0 0.09 0 0 0</pose>
    </model>


    <model name="wall_right">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 5.28 0.18</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 5.28 0.18</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>5.25 0 0.09 0 0 0</pose>
    </model>


    <!-- Mittlere Trennwand für die beiden Geraden -->
    <model name="center_wall">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>7.2 0.10 0.18</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>7.2 0.10 0.18</size>
            </box>
          </geometry>

          <material>
            <ambient>0.9 0.35 0.05 1</ambient>
            <diffuse>0.9 0.35 0.05 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>0 0 0.09 0 0 0</pose>
    </model>


    <!-- Slalom -->
    <model name="cone_1">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.25</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.25</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>1 0.4 0 1</ambient>
            <diffuse>1 0.4 0 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>-1.8 -1.15 0.125 0 0 0</pose>
    </model>


    <model name="cone_2">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.25</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.25</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>1 0.4 0 1</ambient>
            <diffuse>1 0.4 0 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>-0.4 -1.65 0.125 0 0 0</pose>
    </model>


    <model name="cone_3">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.25</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.25</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>1 0.4 0 1</ambient>
            <diffuse>1 0.4 0 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>1.0 -1.15 0.125 0 0 0</pose>
    </model>


    <model name="cone_4">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.25</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.25</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>1 0.4 0 1</ambient>
            <diffuse>1 0.4 0 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>2.4 -1.65 0.125 0 0 0</pose>
    </model>


    <!-- Start-/Ziellinie -->
    <model name="start_finish">
      <static>true</static>

      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 2.45 0.01</size>
            </box>
          </geometry>

          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>-3.6 -1.3 0.008 0 0 0</pose>
    </model>

  </world>
</sdf>
